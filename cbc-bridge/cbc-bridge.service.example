[Unit]
Description=CBC Local Bridge HL7 receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cbcbridge
Group=cbcbridge
WorkingDirectory=/opt/cbc-bridge
EnvironmentFile=/etc/cbc-bridge/cbc-bridge.env
StateDirectory=cbc-bridge
LogsDirectory=cbc-bridge
Environment=CBC_SQLITE_PATH=/var/lib/cbc-bridge/cbc-bridge.sqlite3
Environment=CBC_LOG_PATH=/var/log/cbc-bridge/cbc-bridge.log
ExecStart=/usr/bin/python3 /opt/cbc-bridge/bridge.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cbc-bridge /var/log/cbc-bridge

[Install]
WantedBy=multi-user.target
